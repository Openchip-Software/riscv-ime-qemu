# -*- Mode: makefile -*-
# RISC-V specific tweaks

VPATH += $(SRC_PATH)/tests/tcg/riscv64
TESTS += test-div
TESTS += noexec

# Disable compressed instructions for test-noc
TESTS += test-noc
test-noc: LDFLAGS = -nostdlib -static
run-test-noc: QEMU_OPTS += -cpu rv64,c=false

TESTS += test-aes
run-test-aes: QEMU_OPTS += -cpu rv64,zk=on

# Test for fcvtmod
TESTS += test-fcvtmod
test-fcvtmod: CFLAGS += -march=rv64imafdc
test-fcvtmod: LDFLAGS += -static
run-test-fcvtmod: QEMU_OPTS += -cpu rv64,d=true,zfa=true

TESTS += test-zvvmtls
test-zvvmtls: CFLAGS += -march=rv64gcv
test-zvvmtls: LDFLAGS += -static
run-test-zvvmtls: QEMU_OPTS += -cpu rv64,v=true,vlen=256,x-zvvm=true

# Again with only lambda 1 and 2 supported; the argument tells the test.
run-test-zvvmtls-lambda: test-zvvmtls
	$(call run-test, $@, $(QEMU) $(QEMU_OPTS) \
		-cpu rv64,v=true,vlen=256,x-zvvm=true,zvvm-lambda=3 $< 3)
EXTRA_RUNS += run-test-zvvmtls-lambda

# Again with the all-ones fill for agnostic elements enabled.
run-test-zvvmtls-agnostic: test-zvvmtls
	$(call run-test, $@, $(QEMU) $(QEMU_OPTS) \
		-cpu rv64,v=true,vlen=256,x-zvvm=true,rvv_ta_all_1s=true,rvv_ma_all_1s=true $<)
EXTRA_RUNS += run-test-zvvmtls-agnostic

TESTS += test-zvvmm-int
test-zvvmm-int: CFLAGS += -march=rv64gcv
test-zvvmm-int: LDFLAGS += -static
run-test-zvvmm-int: QEMU_OPTS += -cpu rv64,v=true,vlen=256,x-zvvm=true

TESTS += test-zvvmm-fp
test-zvvmm-fp: CFLAGS += -march=rv64gcv
test-zvvmm-fp: LDFLAGS += -static -lm
run-test-zvvmm-fp: QEMU_OPTS += -cpu rv64,v=true,vlen=256,x-zvvm=true,zfbfmin=true,zvfbfa=true,x-zvfofp8min=true

TESTS += test-zvvmm-mx
test-zvvmm-mx: CFLAGS += -march=rv64gcv
test-zvvmm-mx: LDFLAGS += -static -lm
run-test-zvvmm-mx: QEMU_OPTS += -cpu rv64,v=true,vlen=256,x-zvvm=true,zfbfmin=true,zvfbfa=true,x-zvvfmmmx=true
